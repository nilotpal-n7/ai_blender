# ========================
# Orchestrator (Go)
# ========================
ORCHESTRATOR_PORT=8080
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# ========================
# Frontend (Next.js)
# ========================
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ========================
# Blender Worker (Python)
# ========================
WORKER_REDIS_ADDR=redis:6379
WORKER_REDIS_PASSWORD=
WORKER_JOB_QUEUE=blender:jobs
BLENDER_BIN=/usr/local/blender/blender

# ========================
# AI Model Configuration
# ========================
# Provider: "self_hosted" | "replicate" | "mock"
MODEL_PROVIDER=mock
HUNYUAN3D_ENDPOINT=http://gpu-worker:7860
HUNYUAN3D_TEXTURE=false
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=tencent/hunyuan3d-2.1

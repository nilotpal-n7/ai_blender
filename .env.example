# Copy to .env.local. Everything here is optional: with nothing set the editor
# runs on a small built-in planner.

# Who plans scenes: claude | bridge | offline
#   claude   the Anthropic API (needs ANTHROPIC_API_KEY)
#   bridge   a Claude Code session open in this project answers; no key needed
#   offline  the built-in keyword planner
# Left unset, it is `claude` when a key is present and `offline` otherwise.
# PLANNER=bridge

ANTHROPIC_API_KEY=

# Model and reasoning effort (low | medium | high | xhigh | max) for `claude`.
# PLANNER_MODEL=claude-opus-5-5
# PLANNER_EFFORT=medium

# How long `bridge` waits for the session to reply before giving up.
# BRIDGE_TIMEOUT_MINUTES=10

# The Blender studio starts Blender itself. It looks in the usual install
# places; set this if yours is somewhere else.
# BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe

# Where scenes, Blender projects and bridge traffic are stored. Defaults to ./.data
# DATA_DIR=
